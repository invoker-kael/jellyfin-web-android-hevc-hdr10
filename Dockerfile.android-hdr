FROM node:20-bookworm-slim AS web-build

WORKDIR /src

COPY package.json package-lock.json ./
RUN npm ci --no-audit

COPY . .

RUN npx eslint \
    src/components/apphost.js \
    src/components/playbackSettings/playbackSettings.js \
    src/controllers/dashboard/playback.js \
    src/scripts/androidHdr10.js \
    src/scripts/androidHdr10.test.js \
    src/scripts/browserDeviceProfile.js \
    src/scripts/browserDeviceProfile.androidHdr10.test.js \
    src/scripts/settings/appSettings.js \
    src/scripts/settings/appSettings.androidHdr10.test.js
RUN npm test
RUN npm run build:check
RUN npm run build:es-check

FROM docker.io/invokerkael/jellyfin-android-hevc-hdr@sha256:3ca67ac7483947b60186a8aa2d2a89e64e447999428f6769a0cce3aab883be90

RUN rm -rf /jellyfin/jellyfin-web
COPY --from=web-build /src/dist/ /jellyfin/jellyfin-web/
